<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- A private feed, if the repo has one:
    <add key="private" value="https://nuget.pkg.github.com/OWNER/index.json" />
    -->
  </packageSources>
  <!-- Source mapping: a package comes only from the source mapped to its id (blocks dependency confusion).
       With a private feed, map its own prefix to it and keep "*" on nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!--
    <packageSource key="private">
      <package pattern="Owner.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>
